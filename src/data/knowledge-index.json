  "relations": [
    {
      "id": "r-event-driven-dispatch",
      "from": "event-driven",
      "to": "event-dispatch",
      "type": "composition",
      "reason": "温度变化经规则识别后形成越限事件，分发机制按响应关系通知散热控制和报警显示，连接事实产生与各方行动。",
      "scope": "本文整体机制；传递可由本地调用或通信设施实现，不由事件名称决定。",
      "evidence": "event-driven#whole-system; event-driven#dispatch"
    },
    {
      "id": "r-dispatch-callback",
      "from": "event-dispatch",
      "to": "callback",
      "type": "causal",
      "reason": "本地分发代码遍历登记的处理函数并实际调用，使散热或告警回调开始执行；移除散热登记后，这次越限不会通过该关系调用它。",
      "scope": "进程内函数通知。指调用导致执行，不表示分发创造函数或保证设备动作成功。",
      "evidence": "event-driven#dispatch"
    },
    {
      "id": "r-event-message-event",
      "from": "event",
      "to": "message-event",
      "type": "hierarchy",
      "reason": "消息事件描述消息开始、更新或结束等已发生变化，因此是事件的一类；不应把每个增量通知当作独立历史消息。",
      "scope": "现有消息系统文章的 AgentEvent 与 message_update 说明；本次不修改该文章内容。",
      "evidence": "message-system#events"
    },
    {
      "id": "r-event-async",
      "from": "event-driven",
      "to": "async-control-flow",
      "type": "related",
      "reason": "事件驱动安排谁响应事实，执行机制安排何时运行。同步逐个调用时，散热处理两秒未返回会推迟告警；队列只在额外调度实现存在时改变这条时间关系。",
      "scope": "本文本地同步反例与有队列的异步安排；并行、可靠投递不由事件驱动自动保证。",
      "evidence": "event-driven#timing; https://nodejs.org/api/events.html#asynchronous-vs-synchronous"
    },
    {
      "id": "r-agent-message-event",
      "from": "agent-message",
      "to": "message-event",
      "type": "related",
      "reason": "AgentMessage 是可继续的内部记录，消息事件是这类记录变化时对外发出的运行时通知。",
      "scope": "Pi Agent 的消息系统与事件观察边界。",
      "evidence": "message-system#events"
    },
    {
      "id": "r-external-trigger-event",
      "from": "external-trigger",
      "to": "event",
      "type": "causal",
      "reason": "传感器的新读数到达后，检测代码读取先前超限状态并比较阈值；从未超限变为超限时才发布越限事件，因此外界数值不会自行变成业务通知。",
      "scope": "本文采用阈值跨越规则；其他规则可能选择每次满足条件都报告。",
      "evidence": "event-driven#state-event-command"
    },
    {
      "id": "r-tool-call-execution",
      "from": "tool-call",
      "to": "tool-execution",
      "type": "causal",
      "reason": "工具调用提供名称和参数，运行时据此查找、校验并执行工具。",
      "scope": "Pi Agent 工具运行时。",
      "evidence": "tool-execution"
    },
    {
      "id": "r-event-driven-subscription",
      "from": "event-driven",
      "to": "event-subscription",
      "type": "composition",
      "reason": "本篇机制在越限发生前建立事件与散热控制、报警显示的对应关系，使产生者可以报告事实而不维护所有具体反应。",
      "scope": "采用显式订阅关系的本文机制；装配或配置仍需建立关系。",
      "evidence": "event-driven#whole-system; event-driven#dispatch"
    },
    {
      "id": "r-subscription-dispatch",
      "from": "event-subscription",
      "to": "event-dispatch",
      "type": "related",
      "reason": "订阅建立可查询的响应关系，分发使用关系选择处理者。去掉散热订阅，温度事件仍产生且告警仍可响应，但散热代码不会因此被调用。",
      "scope": "同一事件机制、相同类型约定、登记先于本次分发；不保证业务执行成功。",
      "evidence": "event-driven#dispatch; event-driven#coupling"
    },
    {
      "id": "r-state-event",
      "from": "state",
      "to": "event",
      "type": "related",
      "reason": "当前温度及是否超限是状态，刚刚越限是一次变化记录。检测代码比较新旧状态形成事件；事件传递后，面板等处理者还可以据确实发生的结果更新自己的状态。",
      "scope": "本文阈值跨越与风机结果模型；并非所有状态变化都会被发布，也非每个事件都必须携带完整状态。",
      "evidence": "event-driven#state-event-command; event-driven#result-chain"
    },
    {
      "id": "r-event-command",
      "from": "event",
      "to": "command-message",
      "type": "related",
      "reason": "越限事件报告事实，散热控制据此提出启动命令。命令表达意图，只有设备结果才能支撑风机已启动事件；不能从通知到达直接推出动作成功。",
      "scope": "本文设备控制模型；一个模块可消费事件、发出请求并在获知结果后产生新事件。",
      "evidence": "event-driven#state-event-command; event-driven#result-chain"
    }
  ],
