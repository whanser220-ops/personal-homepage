  "relations": [
    {
      "id": "r-event-driven-dispatch",
      "from": "event-driven",
      "to": "event-dispatch",
      "type": "composition",
      "reason": "一次保存请求产生后，事件驱动链路包含按登记关系选出处理者并通知的分发步骤；数据本身不会调用保存函数。",
      "scope": "本文按事件类型查表的机制；跨进程通知需使用相应通信实现。",
      "evidence": "event-driven#dispatch"
    },
    {
      "id": "r-dispatch-callback",
      "from": "event-dispatch",
      "to": "callback",
      "type": "causal",
      "reason": "分发器根据 save-requested 取出函数列表，执行 handler(event)，使已登记的保存回调开始执行；没有登记就不会由这次分发调用。",
      "scope": "本文同步进程内示例。关系指分发导致回调执行，不表示分发产生函数定义。",
      "evidence": "event-driven#dispatch; event-driven#registration"
    },
    {
      "id": "r-event-message-event",
      "from": "event",
      "to": "message-event",
      "type": "hierarchy",
      "reason": "消息事件描述消息开始、更新或结束等已发生变化，因此是事件的一类；不应把每个增量通知当作独立历史消息。",
      "scope": "现有消息系统文章的 AgentEvent 与 message_update 说明；本次不修改该文章内容。",
      "evidence": "message-system#events"
    },
    {
      "id": "r-event-async",
      "from": "event-driven",
      "to": "async-control-flow",
      "type": "related",
      "reason": "事件与登记关系决定响应者；是否等处理完成再返回由调用和调度实现决定。本篇 publish 循环同步等待保存处理返回，仍然按事件分发。",
      "scope": "本文同步示例及 Node.js EventEmitter；不能由事件驱动名称推出异步或多线程。",
      "evidence": "event-driven#timing; https://nodejs.org/api/events.html#asynchronous-vs-synchronous"
    },
    {
      "id": "r-agent-message-event",
      "from": "agent-message",
      "to": "message-event",
      "type": "related",
      "reason": "AgentMessage 是可继续的内部记录，消息事件是这类记录变化时对外发出的运行时通知。",
      "scope": "Pi Agent 的消息系统与事件观察边界。",
      "evidence": "message-system#events"
    },
    {
      "id": "r-external-trigger-event",
      "from": "external-trigger",
      "to": "event",
      "type": "causal",
      "reason": "用户激活保存按钮后，GUI 工具包识别动作并通知已登记入口；应用入口再把它转换为带文档标识的保存请求事件。",
      "scope": "本文 Swing 按钮到应用保存请求的解释；不把外部动作与业务事件视为同一层对象。",
      "evidence": "event-driven#input; https://docs.oracle.com/javase/tutorial/uiswing/events/actionlistener.html"
    },
    {
      "id": "r-tool-call-execution",
      "from": "tool-call",
      "to": "tool-execution",
      "type": "causal",
      "reason": "工具调用提供名称和参数，运行时据此查找、校验并执行工具。",
      "scope": "Pi Agent 工具运行时。",
      "evidence": "tool-execution"
    },
    {
      "id": "r-event-driven-subscription",
      "from": "event-driven",
      "to": "event-subscription",
      "type": "composition",
      "reason": "本篇事件驱动机制在输入到来前登记保存响应者，给后续分发提供可查询的对应关系。",
      "scope": "使用显式订阅关系的事件机制；本文使用类型到函数列表的映射。",
      "evidence": "event-driven#dispatch"
    },
    {
      "id": "r-subscription-dispatch",
      "from": "event-subscription",
      "to": "event-dispatch",
      "type": "related",
      "reason": "订阅写入事件类型与处理函数的对应表，分发读取同一张表选择调用对象。删除保存函数的登记后，同样点击仍发布事件，却只会通知余下的日志处理者。",
      "scope": "登记先于发布、使用同一个管理器且类型名称一致的教学示例。",
      "evidence": "event-driven#registration"
