      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "monitor-prometheus"
          },
          "expr": "(100 * (sum((server_monitor:http_requests:rate1m{service=~\"$service\",status=~\"5..\"} and (timestamp(server_monitor:http_requests:rate1m{service=~\"$service\",status=~\"5..\"}) == scalar(max(timestamp(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"})))) and on () (max(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"}) > time() - 9) and on () (max(timestamp(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"})) > time() - 9))) or (sum((server_monitor:http_requests:rate1m{service=~\"$service\"} and (timestamp(server_monitor:http_requests:rate1m{service=~\"$service\"}) == scalar(max(timestamp(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"})))) and on () (max(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"}) > time() - 9) and on () (max(timestamp(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"})) > time() - 9))) * 0)) / (sum((server_monitor:http_requests:rate1m{service=~\"$service\"} and (timestamp(server_monitor:http_requests:rate1m{service=~\"$service\"}) == scalar(max(timestamp(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"})))) and on () (max(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"}) > time() - 9) and on () (max(timestamp(server_monitor_http_recorded_at_seconds{host_id=\"cloud-primary\"})) > time() - 9))) > 0)) and on () ((max(up{job=\"server-monitor-http\",host_id=\"cloud-primary\"}) == 1) and (time() - max(timestamp(up{job=\"server-monitor-http\",host_id=\"cloud-primary\"})) < 45))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
