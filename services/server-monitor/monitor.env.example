# Install as /etc/personal-homepage-monitor.env, root:root mode 0600.
# Generate a separate random token and use the same value in the website runtime.
MONITOR_INGEST_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_NON_WHITESPACE_CHARACTERS
MONITOR_INGEST_URL=http://127.0.0.1:3000/api/monitor/ingest
MONITOR_HOST_ID=cloud-primary
MONITOR_STATE_DIR=/var/lib/personal-homepage-monitor
# Optional; otherwise choose the lowest-metric physical default-route interface.
# MONITOR_NETWORK_INTERFACE=ens3
