[Unit]
Description=Independent Prometheus for personal homepage server monitoring
After=network.target personal-homepage-monitor-exporter.service
Wants=personal-homepage-monitor-exporter.service

[Service]
Type=simple
User=prometheus-monitor
Group=prometheus-monitor
WorkingDirectory=/var/lib/personal-homepage-prometheus
Environment=GOMEMLIMIT=256MiB
ExecStart=/opt/personal-homepage-prometheus/releases/3.13.5/prometheus --config.file=/etc/personal-homepage-prometheus/prometheus.yml --storage.tsdb.path=/var/lib/personal-homepage-prometheus --storage.tsdb.retention.time=7d --storage.tsdb.retention.size=1GB --storage.tsdb.wal-compression --web.listen-address=127.0.0.1:19090 --web.max-connections=32 --query.max-concurrency=2 --query.max-samples=5000000 --query.timeout=15s
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=personal-homepage-prometheus
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
MemoryHigh=256M
MemoryMax=512M
CPUQuota=80%
TasksMax=64

[Install]
WantedBy=multi-user.target

