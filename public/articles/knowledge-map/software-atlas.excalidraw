      "id": "s5_os_text",
      "type": "text",
      "x": 210,
      "y": 4630,
      "width": 2300,
      "height": 72.5,
      "fontSize": 29,
      "text": "阻塞 / 非阻塞要落实到具体调用与线程；网络对端是另一运行边界。\n并发看多项工作共同推进；并行看同一时刻执行。两者都不是 async 关键字的别名。",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "originalText": "阻塞 / 非阻塞要落实到具体调用与线程；网络对端是另一运行边界。\n并发看多项工作共同推进；并行看同一时刻执行。两者都不是 async 关键字的别名。"
    },
    {
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeColor": "#B95740",
      "strokeWidth": 2,
