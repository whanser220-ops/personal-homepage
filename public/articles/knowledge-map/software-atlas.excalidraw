      "id": "kernel_title",
      "type": "text",
      "x": 3190,
      "y": 4160,
      "width": 3880,
      "height": 35,
      "fontSize": 28,
      "text": "内核态：执行权限与用户态不同；内核代码同样由 CPU 执行。",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "originalText": "内核态：执行权限与用户态不同；内核代码同样由 CPU 执行。"
    },
    {
      "angle": 0,
      "backgroundColor": "transparent",
